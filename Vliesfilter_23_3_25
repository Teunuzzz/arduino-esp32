void handleDoReset() {
  Serial.println("Resetten van instellingen...");

  RotatieCount = 0;
  lastRotationTime = 0;  // Zorg ervoor dat lastRotationTime gereset blijft.

  // Reset het log volledig
  for (int i = 0; i < LOG_SIZE; i++) {
    rotationLog[i] = 0;  // Stel elk log-item in op 0
  }

  saveState();  // Opslaan in NVS (non-volatile storage)

  server.send(200, "text/plain", "ESP herstart...");

  delay(1000);
  ESP.restart();
}

