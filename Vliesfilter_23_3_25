void handleStartRotation() {
  if (!motorRunning) {
    Serial.println("✅ Manual rotation started...");

    motorRunning = true;
    LastRun = Current_time - PreviousRun;
    PreviousRun = Current_time;
    MotorRunStart = Current_time;
    startMotorCW();

    // Log rotation before updating start time
    logRotationTime(LastRun);

    Starttime = Current_time;
    saveState();
    RotatieCount++;
    saveState();

    server.send(200, "text/plain", "Rotation started");
  } else {
    server.send(400, "text/plain", "Motor is already running");
  }
}

