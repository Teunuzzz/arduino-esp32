// Pin-definities (gebruik GPIO-nummers)
#define FLOAT_SWITCH_PIN 27  // GPIO27 voor de vlotterschakelaar Groen
#define CW_BUTTON_PIN 32     // GPIO32 voor CW-knop Blauw
#define CCW_BUTTON_PIN 33    // GPIO33 voor CCW-knop Groen
#define CW_MOTOR_PIN 25      // GPIO25 voor CW-motor Oranje
#define CCW_MOTOR_PIN 26     // GPIO26 voor CCW-motor Geel

#define LOG_SIZE 5  // Store last 5 rotations
unsigned long rotationLog[LOG_SIZE] = { 0, 0, 0, 0, 0 };
