void checkWiFiConnection() {
    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("⚠️ WiFi verbinding verloren! Opnieuw verbinden...");
        WiFi.disconnect();
        WiFi.reconnect();
        delay(5000);
        if (WiFi.status() == WL_CONNECTED) {
            Serial.println("✅ WiFi opnieuw verbonden!");
        } else {
            Serial.println("❌ WiFi herstel mislukt!");
        }
    }
}

void checkMemory() {
    if (ESP.getFreeHeap() < 20000) {  // Minder dan 20kB RAM → herstart
        Serial.println("⚠️ RAM bijna op! Herstart...");
        saveState();  // 📌 Opslaan vóór herstart
        delay(500);   // Even wachten om te zorgen dat NVS wordt weggeschreve
      
        ESP.restart();
    }
}

String getMemoryUsage() {
    return "Vrij RAM: " + String(ESP.getFreeHeap()) + " bytes";}

// Setup functie
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("ESP32 Start!");

  WiFi.begin(ssid, password);
  Serial.println("Verbinding met WiFi...");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Verbonden! IP: " + WiFi.localIP().toString());

  // Start NTP client
  timeClient.begin();
  timeClient.update();

  if (!MDNS.begin("vliesfilter")) {
    Serial.println("FOUT: mDNS setup mislukt!");
  } else {
    Serial.println("mDNS responder gestart als vliesfilter.local");
    MDNS.addService("http", "tcp", 80);
  }

  // **Register Web Endpoints**
  server.on("/", HTTP_GET, handleDataAPI);
  server.on("/reset", HTTP_GET, handleReset);
  server.on("/do_reset", HTTP_GET, handleDoReset);
  server.on("/start_rotation", HTTP_GET, handleStartRotation);  // Nieuwe endpoint voor handmatige rotatie
  server.on("/upload", HTTP_GET, []() {
    server.send(200, "text/html", serverIndex);
  });
  server.on(
    "/update", HTTP_POST, []() {
      server.send(200, "text/plain", (Update.hasError()) ? "FAIL" : "OK");
    },
    []() {
      HTTPUpload& upload = server.upload();
      if (upload.status == UPLOAD_FILE_START) {
        Update.begin(UPDATE_SIZE_UNKNOWN);
      } else if (upload.status == UPLOAD_FILE_WRITE) {
        Update.write(upload.buf, upload.currentSize);
      } else if (upload.status == UPLOAD_FILE_END) {
        if (Update.end(true)) {
          saveState();
          delay(500);
          ESP.restart();
        }
      }
    });


  server.begin();
  Serial.println("Server gestart!");

  preferences.begin("MotorControl", false);

  // **Pin Configuration**
  pinMode(FLOAT_SWITCH_PIN, INPUT_PULLUP);
  pinMode(CW_BUTTON_PIN, INPUT_PULLUP);
  pinMode(CCW_BUTTON_PIN, INPUT_PULLUP);
  pinMode(CW_MOTOR_PIN, OUTPUT);
  pinMode(CCW_MOTOR_PIN, OUTPUT);
  digitalWrite(CW_MOTOR_PIN, LOW);
  digitalWrite(CCW_MOTOR_PIN, LOW);

  loadState();  // Load saved data

 if (MotorrunTime < 20) {
    MotorrunTime = 20;
    Serial.println("MotorrunTime is te laag, ingesteld op 20 seconden.");
  }

  // **Ensure Starttime is valid**
  if (Starttime == 0 || Starttime > timeClient.getEpochTime()) {
    Serial.println("Starttime is invalid, setting new Starttime.");
    Starttime = timeClient.getEpochTime();
    saveState();
  }

  // **Ensure PreviousRun isn't ahead of Starttime**
  if (PreviousRun > Starttime) {
    Serial.println("PreviousRun was ahead of Starttime, correcting...");
    PreviousRun = Starttime;
    saveState();
  }

  Serial.print("Loaded Starttime: ");
  Serial.println(Starttime);
  Serial.print("Loaded PreviousRun: ");
  Serial.println(PreviousRun);
}

// Loop functie
void loop() {
  server.handleClient();  // Behandel HTTP-verzoeken
  checkWiFiConnection();  // Controleer en herstel WiFi-verbinding
  checkMemory();          // Controleer geheugengebruik
  timeClient.update();    // Update NTP-tijd
  Current_time = timeClient.getEpochTime();  // Gebruik NTP-tijd voor timing
   if (MotorrunTime < 20) {
    MotorrunTime = 20;
    Serial.println("MotorrunTime is te laag, ingesteld op 20 seconden.");
  }

  // Controleer of MotorrunTime minimaal 20 seconden is
  if (MotorrunTime < 20) {
    MotorrunTime = 20;
    Serial.println("MotorrunTime is te laag, ingesteld op 20 seconden.");
  }

  // Lees schakelaar en knoppen
  bool floatSwitchState = digitalRead(FLOAT_SWITCH_PIN);
  bool cwButtonState = debounceButton(CW_BUTTON_PIN);
  bool ccwButtonState = debounceButton(CCW_BUTTON_PIN);

  // Track wanneer de float switch LOW wordt
  if (floatSwitchState == LOW) {
    if (floatSwitchHighStart == 1) {
      floatSwitchHighStart = Current_time;
      Serial.println("Float switch went LOW. Started timing...");
    }
  } else {
    if (floatSwitchHighStart != 1) {
      Serial.println("Float switch returned to HIGH. Resetting timer.");
    }
    floatSwitchHighStart = 1;
  }

  // Automatisch starten van de motor als aan voorwaarden is voldaan
  if (!manualControl && floatSwitchHighStart != 1 && (Current_time - floatSwitchHighStart >= floatSwitchDelay) && (Current_time - Starttime >= MinimumDelay)) {
    Serial.println("✅ Motor conditions met, starting CW motor...");

    motorRunning = true;
    LastRun = Current_time - PreviousRun;
    PreviousRun = Current_time;
    MotorRunStart = Current_time;
    startMotorCW();

    // Log de rotatie voordat de starttijd wordt bijgewerkt
    logRotationTime(LastRun);

    Starttime = Current_time;
    saveState();
    RotatieCount++;
    saveState();
  }

  // Start motor automatisch na 3 dagen (MaximumDelay)
  if (!manualControl && !motorRunning && (PreviousRun > 0) && (Current_time - PreviousRun >= MaximumDelay)) {
    Serial.println("3-day interval reached. Running CW motor...");

    // Bewaar de tijd sinds de laatste rotatie
    LastRun = Current_time - PreviousRun;

    // Log de rotatie voordat de vorige run wordt bijgewerkt
    logRotationTime(Current_time);

    PreviousRun = Current_time;
    Starttime = Current_time;

    motorRunning = true;
    MotorRunStart = Current_time;
    startMotorCW();
    saveState();

    RotatieCount++;
    saveState();
  }

  // Stop de motor na de ingestelde tijd (MotorrunTime)
  if (motorRunning && (Current_time - MotorRunStart >= MotorrunTime)) {
    Serial.println("Motor run complete. Stopping CW motor...");
    stopMotor();
    motorRunning = false;
    manualControl = false;  // Zorg ervoor dat handmatige bediening wordt gereset
    saveState();
  }

  // Handmatige bediening via knoppen
  if (cwButtonState) {
    Serial.println("Manual CW button pressed!");
    startMotorCW();
    manualControl = true;
  } else if (ccwButtonState) {
    Serial.println("Manual CCW button pressed!");
    startMotorCCW();
    manualControl = true;
  } else if (manualControl) {
    Serial.println("Stopping motor after manual control.");
    stopMotor();
    manualControl = false;
  }

  delay(1000);  // Wacht 1 seconde voordat de loop opnieuw begint
}
