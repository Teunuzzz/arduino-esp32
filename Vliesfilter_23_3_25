Preferences preferences;  // NVS opslag (ESP32 opslag)

// Motor en timing instellingen
unsigned long MotorrunTime = 75;
unsigned long MotorrunCorr = 3;
unsigned long RotatieCount = 1;
const unsigned long MinimumDelay = 3600;
const unsigned long MaximumDelay = 259200;

unsigned long Starttime = 0;
unsigned long Current_time = 0;
unsigned long MotorRunStart = 0;
unsigned long LastRun = 0;
unsigned long PreviousRun = 0;
bool motorRunning = false;
bool manualControl = false;

unsigned long floatSwitchHighStart = 1;        // Track when float switch goes high
const unsigned long floatSwitchDelay = 30000;  // 30 seconds delay before activating

// Opslaan van status naar NVS-geheugen
void saveState() {
  preferences.putULong("start_time", Starttime);
  preferences.putULong("prev_run", PreviousRun);
  preferences.putBool("motor_run", motorRunning);
  preferences.putUInt("rotation", RotatieCount);

  // Save last 5 rotation timestamps
  for (int i = 0; i < LOG_SIZE; i++) {
    preferences.putULong(("log_" + String(i)).c_str(), rotationLog[i]);
  }
}

// Laden van opgeslagen status
void loadState() {
  Starttime = preferences.getULong("start_time", 0);
  PreviousRun = preferences.getULong("prev_run", 0);
  motorRunning = preferences.getBool("motor_run", false);
  RotatieCount = preferences.getUInt("rotation", 1);

  // Load last 5 rotation timestamps
  for (int i = 0; i < LOG_SIZE; i++) {
    rotationLog[i] = preferences.getULong(("log_" + String(i)).c_str(), 0);
  }

  // Ensure PreviousRun is valid
  if (PreviousRun == 0 || PreviousRun > timeClient.getEpochTime()) {
    Serial.println("Invalid PreviousRun detected, resetting...");
    PreviousRun = Starttime;  // Avoid large gaps due to uninitialized data
    saveState();
  }
}

void logRotationTime(unsigned long timestamp) {
  // Shift all logs to make room for the new entry
  for (int i = LOG_SIZE - 1; i > 0; i--) {
    rotationLog[i] = rotationLog[i - 1];
  }
  rotationLog[0] = timestamp;  // Store new rotation at index 0
  saveState();                 // Save new log to memory
}

String formatTime(unsigned long sec) {
  unsigned long days = sec / 86400;
  unsigned long hours = (sec % 86400) / 3600;
  unsigned long minutes = (sec % 3600) / 60;
  unsigned long seconds = sec % 60;

  return String(days) + "d " + String(hours) + "h " + String(minutes) + "m " + String(seconds) + "s";
}

// Motor aansturen
void startMotorCW() {
  digitalWrite(CW_MOTOR_PIN, HIGH);
  digitalWrite(CCW_MOTOR_PIN, LOW);
  Serial.println("Motor draait CW");
}

void startMotorCCW() {
  digitalWrite(CW_MOTOR_PIN, LOW);
  digitalWrite(CCW_MOTOR_PIN, HIGH);
  Serial.println("Motor draait CCW");
}

void stopMotor() {
  digitalWrite(CW_MOTOR_PIN, LOW);
  digitalWrite(CCW_MOTOR_PIN, LOW);
  Serial.println("Motor gestopt");
}

// Debounce functie voor knoppen
bool debounceButton(int pin) {
  static unsigned long lastPressTime = 0;
  const unsigned long debounceDelay = 50;
  bool buttonState = !digitalRead(pin);

  if (buttonState) {
    if (millis() - lastPressTime > debounceDelay) {
      lastPressTime = millis();
      return true;
    }
  }
  return false;
}

